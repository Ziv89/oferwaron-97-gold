rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // public read only for chart images (ofernewChart.jpg, ofernewChart1.jpg, ...)
    match /charts/{fileName} {
      allow read: if fileName.matches('ofernewChart(\\d+)?\\.(jpg|jpeg|png|webp)$');
      allow write: if false;
    }

    // public read only for performance report images (ofernewPerformance.jpg, ofernewPerformance1.jpg, ...)
    match /performances/{fileName} {
      allow read: if fileName.matches('ofernewPerformance(\\d+)?\\.(jpg|jpeg|png|webp)$');
      allow write: if false;
    }

    // public read only for self images (ofernewSelfimage.jpg, ofernewSelfimage1.jpg, ...)
    match /selfimages/{fileName} {
      allow read: if fileName.matches('ofernewSelfimage(\\d+)?\\.(jpg|jpeg|png|webp)$');
      allow write: if false;
    }

    // Signed in and approved by the owner (users/{uid}.approval in Firestore,
    // same rule as isApproved in firestore.rules). Cross-service read: the
    // first deploy asks to grant Storage access to Firestore - accept it.
    function isApprovedMember() {
      return request.auth != null
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data
             .get('approval', 'approved') == 'approved';
    }

    // public read only for scan code images (ofernewScancode.jpg, ofernewScancode1.jpg, ...)
    // except ofernewScancode4 (WhatsApp group) - approved members only
    match /scancodes/{fileName} {
      allow read: if fileName.matches('ofernewScancode(\\d+)?\\.(jpg|jpeg|png|webp)$')
        && (!fileName.matches('ofernewScancode4\\..*') || isApprovedMember());
      allow write: if false;
    }

    // public read only for the CV documents (cv.pdf, cv.docx)
    match /documents/{fileName} {
      allow read: if fileName.matches('cv\\.(pdf|docx)$');
      allow write: if false;
    }

    // public read only for the logo (SantaLogo.jpeg - Live Alerts group picture)
    match /logos/{fileName} {
      allow read: if fileName.matches('SantaLogo\\.(jpg|jpeg|png|webp)$');
      allow write: if false;
    }

    // public read only for UI sound effects (alertEffect.mp3 - played on new Live Alerts)
    match /soundeffect/{fileName} {
      allow read: if fileName.matches('alertEffect\\.(mp3|wav|ogg)$');
      allow write: if false;
    }

    // block everything else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
